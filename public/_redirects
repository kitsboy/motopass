
# App routes: a deep link must return the SPA shell with a 200. Without
# these, Cloudflare serves the 404 page for every route that is not a file
# on disk, so /proof and /pitch were dead for anyone arriving from a link.
/agents   /index.html   200
/agents/* /index.html   200
/apply   /index.html   200
/apply/* /index.html   200
/btcmap   /index.html   200
/btcmap/* /index.html   200
/blog   /index.html   200
/blog/* /index.html   200
/compare   /index.html   200
/compare/* /index.html   200
/dashboard   /index.html   200
/dashboard/* /index.html   200
/distressed   /index.html   200
/distressed/* /index.html   200
/portfolio   /index.html   200
/portfolio/* /index.html   200
/profile   /index.html   200
/profile/* /index.html   200
/programs   /index.html   200
/programs/* /index.html   200
/proof   /index.html   200
/proof/* /index.html   200
/register   /index.html   200
/register/* /index.html   200
/simulator   /index.html   200
/simulator/* /index.html   200
/sources   /index.html   200
/sources/* /index.html   200
/tools   /index.html   200
/tools/* /index.html   200
/trust   /index.html   200
/trust/* /index.html   200
/vault   /index.html   200
